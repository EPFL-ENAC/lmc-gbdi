# Copied to .env by `make install` (or the first `make up`).
# Local-only credentials: never reuse them anywhere shared.
POSTGRES_USER=gbdi
POSTGRES_PASSWORD=gbdi
POSTGRES_DB=gbdi

# Host ports, bound to 127.0.0.1. Change them if they clash with another
# stack (co2-calculator uses 80 and 5432 too).
HTTP_PORT=80
POSTGRES_PORT=5432
