# Copied to backend/.env by `make install`. Used only when running the API on
# the host (make dev-backend) against the compose postgres (make db).
# Must match the root .env (POSTGRES_* and POSTGRES_PORT).
DB_URL=postgresql+psycopg://gbdi:gbdi@localhost:5432/gbdi

# One OpenBDF project for /api/overview, exported by scripts/openbdf_xlsx_to_csv.py.
# Unset, the endpoint answers 503. The export is gitignored (backend/data/).
# OPENBDF_DATA_DIR=data/openbdf
